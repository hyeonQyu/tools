{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.cursor.com)",
      "WebFetch(domain:cursor.com)",

      "Bash(ls *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(head *)",
      "Bash(tail *)",

      "Bash(grep *)",
      "Bash(rg *)",

      "Bash(xargs *)",
      "Bash(awk *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",

      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(date *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(true)",
      "Bash(false)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git remote *)",
      "Bash(git check-ignore *)",
      "Bash(git config --get *)",

      "Bash(git add *)",
      "Bash(git restore --staged *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git commit -m *)",
      "Bash(git commit -am *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh api *)",
      "Bash(gh auth status)",

      "Bash(yarn type)",
      "Bash(yarn lint)",
      "Bash(yarn lint:fix)",
      "Bash(yarn build)",

      "Bash(node --version)",
      "Bash(tsc --noEmit)",
      "Bash(tsc -v)",

      "Skill(update-config)",
      "Skill(update-config:*)"
    ],
    "ask": [
      "Bash(yarn dev)",
      "Bash(yarn preview)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(git branch -D *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr ready *)",
      "Bash(YARN_ENABLE_IMMUTABLE_INSTALLS=false yarn install)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/serviceAccount*.json)",
      "Write(**/serviceAccount*.json)",
      "Edit(**/serviceAccount*.json)",
      "Read(**/firebase-adminsdk*.json)",
      "Read(**/*-firebase-adminsdk-*.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; [ -n \"$f\" ] || exit 0; case \"$f\" in \"$PWD\"/*) npx --no-install prettier --write --ignore-unknown \"$f\" ;; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
